#!name=Duolingo 解锁 自定义限时挑战时长
#!desc=Duolingo 解锁 自定义限时挑战时长
#!arguments=timer_mins:10
#!author=Takagivegeta
#!homepage=https://github.com/TAKAGIVEGETA/MyScripts/tree/main/lingoDuo
#!icon=https://raw.githubusercontent.com/TAKAGIVEGETA/MyScripts/main/lingoDuo/lingoDuo.png

[Script]
Duolingo-Timer = type=http-response,pattern=^https:\/\/(?:ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(?:n|om)\/.*\/live-ops-challenges,script-path=https://raw.githubusercontent.com/mpc2008cn/surge-list/master/lingoDuo/lingoDuo-time-modifier.js,requires-body=true,timeout=120,argument={{{timer_mins}}}

[MITM]
hostname = ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn
